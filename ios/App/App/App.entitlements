<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	iCloud key-value storage syncs the chord library across devices. Personal (free) teams can't
	sign the iCloud capability, so it's off for device testing; the library then stays on-device
	(src/lib/cloudLibrary.ts falls back to localStorage). Re-enable with a paid Developer Program team:
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	-->
</dict>
</plist>
